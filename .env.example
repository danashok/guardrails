PORT=8080

# --- Postgres (audit log) ---
POSTGRES_USER=guardrails
POSTGRES_PASSWORD=guardrails
POSTGRES_DB=guardrails

# --- App-side connection string (uses the Postgres service name on the docker network) ---
DB_DRIVER=postgres
DB_SOURCE=postgresql://guardrails:guardrails@guardrails_db:5432/guardrails?sslmode=disable

# --- Auth: shared secret. Must match GUARDRAIL_API_KEY in ai-gateway/.env ---
GUARDRAIL_API_KEY=replace-with-shared-secret

# --- Audit pipeline ---
AUDIT_ENABLED=true
AUDIT_WORKERS=4
AUDIT_BUFFER=1024

# --- Concurrency cap per request ---
MAX_CONCURRENT_CHECKS=32
MAX_BODY_BYTES=262144

# --- Authorization (per-user IP allowlist) ---
# TTL for the in-memory cache of allowed IPs per ntaccount.
AUTHZ_CACHE_TTL=60s

GIN_MODE=release
